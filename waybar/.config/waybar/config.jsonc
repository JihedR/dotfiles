// ctOS-style Waybar - mirrors ~/ctOS/bar.qml until the Quickshell bar is finished
{
  "layer": "top",
  "position": "top",
  "height": 37,
  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left": ["custom/ct", "custom/os", "hyprland/workspaces", "cpu", "memory"],
  "modules-center": [],
  "modules-right": ["tray", "custom/notification", "pulseaudio", "network", "custom/user", "clock"],

  // ── system label ─────────────────────────────────────────
  "custom/ct": {
    "format": " CT", // nf-linux-endeavour
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "custom/os": {
    "format": "OS",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },

  // ── workspaces: click to switch, scroll to cycle ─────────
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "+",
      "urgent": "!",
      "empty": "",
      "default": "·"
    },
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  // ── meters ───────────────────────────────────────────────
  "cpu": {
    "interval": 2,
    "format": "CPU &lt;&gt; {usage:03}% {icon}",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  },
  "memory": {
    "interval": 2,
    "format": "MEM ## {used:0.1f}G {icon}",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G  ·  swap {swapUsed:0.1f}G"
  },

  // ── right side ───────────────────────────────────────────
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/notification": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "<span color='#1bfd9c'>●</span> MSG",
      "none": "○ MSG",
      "dnd-notification": "<span color='#fc3e38'>●</span> DND",
      "dnd-none": "○ DND",
      "inhibited-notification": "<span color='#1bfd9c'>●</span> MSG",
      "inhibited-none": "○ MSG",
      "dnd-inhibited-notification": "<span color='#fc3e38'>●</span> DND",
      "dnd-inhibited-none": "○ DND"
    },
    "tooltip": false,
    "escape": true,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  "pulseaudio": {
    "format": "VOL {volume:03}%",
    "format-muted": "VOL -MUTE",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "scroll-step": 5
  },
  "network": {
    "interval": 5,
    "format-ethernet": "<span color='#1bfd9c'>●</span> -WIRED-",
    "format-wifi": "<span color='#1bfd9c'>●</span> {essid}",
    "format-disconnected": "<span color='#7a7a7a'>●</span> --N/A--",
    "format-linked": "<span color='#7a7a7a'>●</span> NO-IP",
    "tooltip-format": "{ifname}  {ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "max-length": 16
  },
  "custom/user": {
    "exec": "id -un | tr '[:lower:]' '[:upper:]'",
    "interval": "once",
    "format": "▨ {}",
    "tooltip": false
  },
  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S}",
    "format-alt": "{:%Y-%m-%d}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "today": "<span color='#1bfd9c'><b>{}</b></span>"
      }
    }
  }
}
