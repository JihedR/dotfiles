// ctOS-style Waybar - mirrors ~/ctOS/bar.qml until the Quickshell bar is finished
{
  "layer": "top",
  "position": "top",
  "height": 37,
  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left": ["custom/ct", "custom/os", "group/ws", "group/cpu", "group/mem"],
  "modules-center": [],
  "modules-right": ["tray", "custom/notification", "custom/net", "custom/id", "custom/mic", "wireplumber", "clock"],

  // ── system label ─────────────────────────────────────────
  "custom/ct": {
    "format": " CT", // nf-linux-endeavour
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "custom/os": {
    "format": "OS",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },

  // ── workspaces ───────────────────────────────────────────
  // Waybar's built-in hyprland/workspaces sends "dispatch workspace N", which
  // Hyprland 0.56 (Lua config) rejects, so clicks did nothing. These cells
  // dispatch hl.dsp.focus. One hidden listener (custom/ws-listen) watches
  // Hyprland's events and signals the cells (SIGRTMIN+8) to redraw.
  "group/ws": {
    "orientation": "horizontal",
    "modules": ["custom/ws-listen", "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5"]
  },
  "custom/ws-listen": {
    "exec": "~/.config/waybar/scripts/ctos-ws listen",
    "tooltip": false
  },
  "custom/ws1": {
    "exec": "~/.config/waybar/scripts/ctos-ws cell 1", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false,
    "on-click": "~/.config/waybar/scripts/ctos-ws focus 1",
    "on-scroll-up": "~/.config/waybar/scripts/ctos-ws scroll prev",
    "on-scroll-down": "~/.config/waybar/scripts/ctos-ws scroll next"
  },
  "custom/ws2": {
    "exec": "~/.config/waybar/scripts/ctos-ws cell 2", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false,
    "on-click": "~/.config/waybar/scripts/ctos-ws focus 2",
    "on-scroll-up": "~/.config/waybar/scripts/ctos-ws scroll prev",
    "on-scroll-down": "~/.config/waybar/scripts/ctos-ws scroll next"
  },
  "custom/ws3": {
    "exec": "~/.config/waybar/scripts/ctos-ws cell 3", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false,
    "on-click": "~/.config/waybar/scripts/ctos-ws focus 3",
    "on-scroll-up": "~/.config/waybar/scripts/ctos-ws scroll prev",
    "on-scroll-down": "~/.config/waybar/scripts/ctos-ws scroll next"
  },
  "custom/ws4": {
    "exec": "~/.config/waybar/scripts/ctos-ws cell 4", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false,
    "on-click": "~/.config/waybar/scripts/ctos-ws focus 4",
    "on-scroll-up": "~/.config/waybar/scripts/ctos-ws scroll prev",
    "on-scroll-down": "~/.config/waybar/scripts/ctos-ws scroll next"
  },
  "custom/ws5": {
    "exec": "~/.config/waybar/scripts/ctos-ws cell 5", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false,
    "on-click": "~/.config/waybar/scripts/ctos-ws focus 5",
    "on-scroll-up": "~/.config/waybar/scripts/ctos-ws scroll prev",
    "on-scroll-down": "~/.config/waybar/scripts/ctos-ws scroll next"
  },

  // ── meters: value + thin fill bar (ctOS Meter) ───────────
  // each in a group so the group carries the divider and the module the frame
  "group/cpu": { "orientation": "horizontal", "modules": ["custom/cpu"] },
  "group/mem": { "orientation": "horizontal", "modules": ["custom/mem"] },
  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/ctos-meter cpu",
    "return-type": "json"
  },
  "custom/mem": {
    "exec": "~/.config/waybar/scripts/ctos-meter mem",
    "return-type": "json"
  },

  // ── right side ───────────────────────────────────────────
  "tray": {
    "icon-size": 12,
    "spacing": 6
  },
  "custom/notification": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "<span color='#1bfd9c'>●</span> MSG",
      "none": "○ MSG",
      "dnd-notification": "<span color='#fc3e38'>●</span> DND",
      "dnd-none": "○ DND",
      "inhibited-notification": "<span color='#1bfd9c'>●</span> MSG",
      "inhibited-none": "○ MSG",
      "dnd-inhibited-notification": "<span color='#fc3e38'>●</span> DND",
      "dnd-inhibited-none": "○ DND"
    },
    "tooltip": false,
    "escape": true,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  "custom/net": {
    "exec": "~/.config/waybar/scripts/ctos-net",
    "return-type": "json",
    "interval": 5
  },
  "custom/id": {
    "exec": "id -un | tr '[:lower:]' '[:upper:]'",
    "interval": "once",
    "format": "[ID_{}]",
    "tooltip": false
  },
  // hidden unless the mic is muted or an app is recording; mute toggle refreshes it via SIGRTMIN+9
  "custom/mic": {
    "exec": "~/.config/waybar/scripts/ctos-mic",
    "return-type": "json",
    "interval": 2,
    "signal": 9,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; pkill -RTMIN+9 -x waybar"
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "tooltip-format": "VOL // {volume}%",
    "max-volume": 100,
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  // [YYYY-MM-DD // HH:MM]
  "clock": {
    "format": "[{:%Y-%m-%d // %H:%M}]",
    "tooltip-format": "{:%A %d %B %Y}",
    "interval": 60
  }
}
