#!/usr/bin/env bash
# CPU / MEM meters for Waybar, after ~/ctOS/bar/components/Meter.qml:
# the value on top, a thin fill bar underneath. Prints one JSON line every 2 s.
#   ctos-meter cpu | mem
set -u

WIDTH=24                       # bar length in characters
FILL='#d9d9d9' TRACK='#7a7a7a' # ctos / secondary

repeat() { # string, count
    local out="" i
    for ((i = 0; i < $2; i++)); do out+=$1; done
    printf '%s' "$out"
}

# fill bar for a percentage, as Pango markup
bar() {
    local pct=$1 fill
    ((pct < 0)) && pct=0
    ((pct > 100)) && pct=100
    fill=$(((pct * WIDTH + 50) / 100))
    printf "<span font_size='5pt' line_height='0.7'><span color='%s'>%s</span><span color='%s'>%s</span></span>" \
        "$FILL" "$(repeat ━ "$fill")" "$TRACK" "$(repeat ━ $((WIDTH - fill)))"
}

emit() { # text, percentage, tooltip
    jq -cn --arg text "$1"$'\n'"$(bar "$2")" --arg tooltip "$3" '{text: $text, tooltip: $tooltip}'
}

case "${1:-}" in
cpu)
    # same maths as ~/ctOS/bar.qml: idle = idle + iowait, total = user..softirq
    last_total=0 last_idle=0
    while :; do
        read -r _ user nice system idle iowait irq softirq _ </proc/stat
        idle=$((idle + iowait))
        total=$((user + nice + system + idle + irq + softirq))
        if ((last_total > 0 && total > last_total)); then
            pct=$((100 * (total - last_total - (idle - last_idle)) / (total - last_total)))
            emit "$(printf 'CPU &lt;&gt;  %03d%%' "$pct")" "$pct" "CPU ${pct}%"
        fi
        last_total=$total last_idle=$idle
        sleep 2
    done
    ;;
mem)
    while :; do
        read -r total used swap_used < <(free -m | awk '/^Mem:/ {t=$2; u=$3} /^Swap:/ {s=$3} END {print t, u, s}')
        pct=$((used * 100 / total))
        emit "$(awk -v u="$used" 'BEGIN {printf "MEM ##  %.1fG", u / 1024}')" "$pct" \
            "$(awk -v u="$used" -v t="$total" -v s="$swap_used" 'BEGIN {printf "%.1fG / %.1fG  ·  swap %.1fG", u/1024, t/1024, s/1024}')"
        sleep 2
    done
    ;;
*)
    echo "usage: ctos-meter cpu | mem" >&2
    exit 2
    ;;
esac
