#!/usr/bin/env bash
# [NW_xxxx] tag for Waybar: green dot + short hash of the local IPv4 while there
# is a route out, red dot + [NW_----] when offline. "ip route get" only asks the
# kernel's routing table; nothing is sent. CTOS_NET_ROUTE overrides its output
# (for testing the offline branch).
set -u

ACCENT='#1bfd9c' ERROR='#fc3e38'

route=${CTOS_NET_ROUTE-$(ip -4 route get 1.1.1.1 2>/dev/null)}
read -r dev src < <(awk '{for (i = 1; i < NF; i++) {if ($i == "dev") d = $(i+1); if ($i == "src") s = $(i+1)}} END {print d, s}' <<<"$route")

if [ -n "${src:-}" ]; then
    hash=$(printf '%s' "$src" | sha1sum | cut -c1-4 | tr 'a-f' 'A-F')
    text="<span color='$ACCENT'>●</span> [NW_$hash]" tooltip="$dev  $src" class="online"
else
    text="<span color='$ERROR'>●</span> [NW_----]" tooltip="offline" class="offline"
fi

jq -cn --arg text "$text" --arg tooltip "$tooltip" --arg class "$class" \
    '{text: $text, tooltip: $tooltip, class: $class}'
