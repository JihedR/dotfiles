#!/usr/bin/env bash
# Encoded status string for Waybar, after ~/ctOS/bar/components/Status.qml:
#   󰁱 00YYYY-MMDD-HHMM-CET-MIC045VOL060 󰁱    (--- while muted)
# Waybar runs it every 2 s and on SIGRTMIN+9 (sent by the volume actions).
set -u

DIM='#cacaca' TEXT='#ffffff' CTOS='#d9d9d9' # text_dim / text / ctos
BARCODE=$'\U000F0071'                        # nf-md-barcode

level() { # wpctl target -> 3-digit percent, or --- when muted
    local out
    out=$(wpctl get-volume "$1" 2>/dev/null) || { echo '???'; return; }
    [[ $out == *MUTED* ]] && { echo '---'; return; }
    awk '{printf "%03d", $2 * 100 + 0.5}' <<<"$out"
}

mic=$(level @DEFAULT_AUDIO_SOURCE@)
vol=$(level @DEFAULT_AUDIO_SINK@)

text="<span color='$CTOS'>$BARCODE</span> "
text+="<span color='$DIM'>$(date +'00%Y-%m%d')-</span>"
text+="<span color='$TEXT'>$(date +'%H%M')</span>"
text+="<span color='$DIM'>-$(date +'%Z')-</span>"
text+="<span color='$TEXT'>MIC$mic""VOL$vol</span>"
text+=" <span color='$CTOS'>$BARCODE</span>"

tooltip="$(date +'%A %d %B %Y // %H:%M:%S' | tr '[:lower:]' '[:upper:]')"$'\n'"MIC $mic  VOL $vol"

jq -cn --arg text "$text" --arg tooltip "$tooltip" '{text: $text, tooltip: $tooltip}'
