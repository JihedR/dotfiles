configuration {
  modi:                "drun,run,window";
  show-icons:          true;
  icon-theme:          "breeze-dark";
  drun-display-format: "{name}";
  display-drun:        "LAUNCH";
  display-run:         "EXEC";
  display-window:      "PROC";
  matching:            "fuzzy";
  sort:                true;
}

@theme "ctos"
