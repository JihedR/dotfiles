configuration {
  modi:                "drun,run,window";
  show-icons:          true;
  icon-theme:          "breeze-dark";
  drun-display-format: "{name}";
  display-drun:        "LAUNCH";
  display-run:         "EXEC";
  display-window:      "PROC";
  matching:            "fuzzy";
  sort:                true;
  /* Super+r cycles LAUNCH -> EXEC -> PROC while open (Hyprland passes it through) */
  kb-mode-next:        "Shift+Right,Control+Tab,Super+r";
}

@theme "ctos"
